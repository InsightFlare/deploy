{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "insightflare-deploy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "https://deploy.insightflare.net",
    "SOURCE_REPOSITORY": "RavelloH/InsightFlare",
    "CF_OAUTH_SCOPES": "workers-scripts.read account-settings.read zone.read",
    "ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "DeploySession" },
      { "name": "RUNS", "class_name": "DeploymentRun" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeploySession"] },
    { "tag": "v2", "new_sqlite_classes": ["DeploymentRun"] }
  ]
}
