{
  "name": "@insightflare/deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InsightFlare deployment control plane for Cloudflare",
  "scripts": {
    "dev": "wrangler dev --local --var APP_ORIGIN:http://localhost:8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=22"
  }
}
