{
  "name": "@insightflare/deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InsightFlare deployment control plane for Cloudflare",
  "scripts": {
    "dev": "pnpm build:web && wrangler dev --local --var APP_ORIGIN:http://localhost:8787",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build": "pnpm build:web && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/pack-build.nodecheck.mjs",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm build:web && wrangler deploy"
  },
  "dependencies": {
    "@insightflare/ui": "0.7.1",
    "@remixicon/react": "^4.9.0",
    "hono": "^4.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "es-module-lexer": "^3.0.4",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=22"
  }
}
